# Include under Nginx http {}. Replace both domains, certificates and roots.
# Keep Nginx variables ($host, $uri, etc.) unchanged. Merge defaults with existing sites.
map $http_upgrade $hm_connection_upgrade { default upgrade; '' close; }
# Avoid recording OAuth codes and tokens in query strings.
log_format hm_path_only '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';

server { listen 80 default_server; server_name _; return 444; }
server {
    listen 80;
    server_name admin.hm.example.invalid service.hm.example.invalid;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/nginx/certs/hm-admin/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/hm-admin/privkey.pem;
    return 444;
}
server {
    listen 443 ssl;
    server_name admin.hm.example.invalid;
    ssl_certificate /etc/nginx/certs/hm-admin/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/hm-admin/privkey.pem;
    root /opt/hm/current/admin;
    index index.html;
    client_max_body_size 32m;
    access_log /var/log/nginx/hm-admin-access.log hm_path_only;
    location ~ ^/(admin-api|app-api)/ {
        proxy_pass http://127.0.0.1:48080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
    location /infra/ws {
        proxy_pass http://127.0.0.1:48080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hm_connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
    }
    location = /index.html { add_header Cache-Control "no-cache"; }
    location / { try_files $uri $uri/ /index.html; }
}
# Add one explicit server_name/certificate for each verified tenant domain.
server {
    listen 443 ssl;
    server_name service.hm.example.invalid;
    ssl_certificate /etc/nginx/certs/hm-portal/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/hm-portal/privkey.pem;
    root /opt/hm/current/portal;
    index index.html;
    client_max_body_size 8m;
    access_log /var/log/nginx/hm-portal-access.log hm_path_only;
    location /app-api/ {
        proxy_pass http://127.0.0.1:48080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
    location /admin-api/ { return 404; }
    location = /index.html { add_header Cache-Control "no-cache"; }
    location / { try_files $uri $uri/ /index.html; }
}
# NEVER add an alias/root for HM_EVIDENCE_ROOT. Evidence is served only by authenticated order APIs.
