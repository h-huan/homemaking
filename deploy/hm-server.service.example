# Copy to /etc/systemd/system/hm-server.service after checking every path and the hm account.
# This template is for one Linux host running Nginx and Java directly, not Docker.
[Unit]
Description=HM Homemaking Server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=hm
Group=hm
WorkingDirectory=/opt/hm/current
EnvironmentFile=/etc/hm/backend.env
ExecStart=/usr/bin/java -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai -jar /opt/hm/current/hm-server.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0027

[Install]
WantedBy=multi-user.target
