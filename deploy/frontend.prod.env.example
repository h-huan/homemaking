# Copy to hm-ui/.env.prod.local BEFORE pnpm build:prod.
# This project uses --mode prod, not --mode production.
# All VITE_* values are public build-time values. Never put database/provider secrets here.
NODE_ENV=production
VITE_DEV=false
VITE_APP_TITLE=HM 家政管理平台

# Empty uses the website's own HTTPS origin; the provided Nginx template routes both APIs.
VITE_BASE_URL=
VITE_API_URL=/admin-api
VITE_BASE_PATH=/
VITE_OUT_DIR=dist-prod
VITE_UPLOAD_TYPE=server

VITE_APP_TENANT_ENABLE=true
VITE_APP_CAPTCHA_ENABLE=true
VITE_APP_DOCALERT_ENABLE=false
VITE_APP_DEFAULT_LOGIN_TENANT=HM 总部
VITE_APP_DEFAULT_LOGIN_USERNAME=
VITE_APP_DEFAULT_LOGIN_PASSWORD=
VITE_APP_BAIDU_CODE=
VITE_BAIDU_MAP_KEY=

# Optional API encryption requires coordinated backend changes; default is disabled.
VITE_APP_API_ENCRYPT_ENABLE=false
VITE_APP_API_ENCRYPT_HEADER=X-Api-Encrypt
VITE_APP_API_ENCRYPT_ALGORITHM=AES
VITE_APP_API_ENCRYPT_REQUEST_KEY=
VITE_APP_API_ENCRYPT_RESPONSE_KEY=

VITE_DROP_DEBUGGER=true
VITE_DROP_CONSOLE=true
VITE_SOURCEMAP=false
VITE_COMPRESS=none

# Optional modules are disabled by default.
VITE_MALL_H5_DOMAIN=
VITE_GOVIEW_URL=
