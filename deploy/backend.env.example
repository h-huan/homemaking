# Copy to a private server file, for example /etc/hm/backend.env.
# Replace every CHANGE_ME value. This is an environment file, not a Spring .env auto-loader.
# Java must inherit these values via systemd EnvironmentFile or an exported shell environment.
# Values are single-quoted for Bash/systemd. Do not put secrets in frontend VITE_* variables.

HM_PROFILE='prod'
HM_BIND_ADDRESS='127.0.0.1'
HM_PORT='48080'

# Change database host, port AND database name; use the same database when importing SQL.
# sslMode=REQUIRED requires TLS. Use VERIFY_IDENTITY with a trusted certificate for remote DB identity verification.
HM_DB_URL='jdbc:mysql://CHANGE_ME_DB_HOST:3306/CHANGE_ME_DATABASE?sslMode=REQUIRED&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8'
HM_DB_USER='CHANGE_ME_DB_USER'
HM_DB_PASSWORD='CHANGE_ME_DB_PASSWORD'
HM_DATA_ENCRYPTION_KEY='CHANGE_ME'

HM_REDIS_HOST='CHANGE_ME_REDIS_HOST'
HM_REDIS_PORT='6379'
HM_REDIS_DATABASE='0'
HM_REDIS_PASSWORD='CHANGE_ME_REDIS_PASSWORD'

# Public HTTPS origin only: no /admin-api, /app-api or trailing slash.
HM_PUBLIC_API_URL='https://CHANGE_ME_PUBLIC_HOST'
HM_ADMIN_URL='https://CHANGE_ME_ADMIN_HOST'
HM_LOG_FILE='/var/log/hm/hm-server.log'

# Keep false until identities, templates, preferences and real channel delivery are verified.
HM_HOMEMAKING_NOTIFICATION_DELIVERY_ENABLED='false'

# Optional framework integrations; blank when unused.
# These do NOT register tenant WeChat apps in hm_wechat_app.
HM_WECHAT_MP_APP_ID=''
HM_WECHAT_MP_SECRET=''
HM_WECHAT_MINI_APP_ID=''
HM_WECHAT_MINI_SECRET=''
# Optional location service; keep blank when unused.
HM_TENCENT_LBS_KEY=''
HM_SUPPORT_EMAIL=''

# API encryption is disabled in application.yaml. Leave these empty in the default deployment.
HM_API_REQUEST_KEY=''
HM_API_RESPONSE_KEY=''

# Tenant WeChat secrets: uncomment only for apps you actually register.
# The secretEnv field in POST /admin-api/homemaking/wechat-apps must match the variable name exactly.
# HM_WECHAT_MINI_HQ_SECRET='CHANGE_ME_MINI_APP_SECRET'
# HM_WECHAT_MP_HQ_SECRET='CHANGE_ME_MP_APP_SECRET'

# Optional operational tuning (Spring canonical property mappings).
# HM_HOMEMAKING_NOTIFICATION_POLL_MS='15000'
# SPRING_DATASOURCE_DYNAMIC_DATASOURCE_MASTER_NAME='CHANGE_ME_DATABASE'
# The latter is only the code generator's schema name; HM_DB_URL controls the actual database connection.
