.content-page {
  background:
    radial-gradient(circle at top right, rgba(240, 138, 36, 0.08), transparent 220rpx),
    var(--hm-canvas);
}

.content-card {
  padding: 0;
  overflow: hidden;
}

.content-header {
  padding: 36rpx 32rpx 28rpx;
  background: linear-gradient(180deg, #fff8ef 0%, #ffffff 100%);
}

.content-eyebrow {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #fff1e3;
  color: #c96827;
  font-size: 22rpx;
}

.content-title {
  margin-top: 20rpx;
  font-size: 42rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #1f2937;
}

.content-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #6b7280;
}

.content-meta {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.content-summary {
  margin: 28rpx 32rpx 0;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--hm-canvas);
  color: #7c5e48;
  line-height: 1.8;
}

.content-cover {
  margin: 28rpx 32rpx 0;
  overflow: hidden;
  border-radius: 28rpx;
}

.content-cover-image {
  width: 100%;
  height: 320rpx;
}

.content-rich {
  padding: 32rpx;
  color: #374151;
  line-height: 1.9;
  font-size: 28rpx;
}
