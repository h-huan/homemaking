<view class="page" style="{{themeStyle}}">
  <view class="empty-wrap">
    <view class="empty-illus"></view>
    <view class="section-title">{{title}}</view>
    <view class="muted">网络或接口暂时不可用，请稍后重试</view>
  </view>
  <button class="primary-btn" bindtap="retry">重新加载</button>
  <button class="ghost-btn result-btn" bindtap="goHome">返回首页</button>
</view>
