<view class="page safe-bottom home-page" style="{{themeStyle}}">
  <view class="home-intro"><text class="eyebrow">{{home.brandName || 'HM 家政'}} · 到家服务</text><view class="home-title">生活有序，<text>安心到家。</text></view><view class="home-subtitle">把家务交给专业，把时间留给生活。</view></view>
  <view class="home-search" bindtap="openSearch"><text class="home-search-label">找服务</text><text class="muted">{{searchConfig.placeholder}}</text><text class="search-arrow">↗</text></view>
  <view class="home-steps"><text>01 选择服务</text><text>02 预约时间</text><text>03 安心上门</text></view>
  <view class="section" wx:if="{{modules.services}}">
    <view class="section-head"><view class="section-title">今天，家里需要什么？</view><view class="section-desc" bindtap="goCategoryTab">全部服务 ›</view></view>
    <view class="home-categories"><view class="home-category" wx:for="{{serviceNavList}}" wx:key="id" data-id="{{item.id}}" data-path="{{item.path}}" bindtap="goServiceList"><image wx:if="{{item.iconUrl}}" src="{{item.iconUrl}}" mode="aspectFit"/><view class="category-letter" wx:else>{{item.title}}</view><text>{{item.title}}</text></view></view>
  </view>
  <view class="section" wx:if="{{modules.banners && home.bannerList.length}}"><swiper autoplay circular indicator-dots class="home-banners"><swiper-item wx:for="{{home.bannerList}}" wx:key="index"><image src="{{item.imageUrl || item.bannerImage}}" mode="aspectFill"/></swiper-item></swiper></view>
  <view class="section" wx:if="{{modules.services}}">
    <view class="section-head"><view><text class="eyebrow">为日常留一份从容</text><view class="section-title">{{sectionConfig.recommendTitle}}</view></view><view class="section-desc" bindtap="goCategoryTab">更多 ›</view></view>
    <view class="home-service" wx:for="{{home.hotServiceList}}" wx:key="serviceItemId" data-id="{{item.serviceItemId}}" bindtap="goDetail"><image wx:if="{{item.serviceCover}}" class="home-service-cover" src="{{item.serviceCover}}" mode="aspectFill"/><view wx:else class="home-service-cover home-service-placeholder">HM</view><view class="home-service-copy"><view class="home-service-name">{{item.serviceName}}</view><view class="muted home-service-desc">{{item.serviceSubTitle || '标准服务，明码标价'}}</view><view class="home-service-bottom"><text class="price-text">¥{{item.basePrice}}<text class="price-unit">起</text></text><text class="home-service-action">查看服务 ↗</text></view></view></view>
    <view wx:if="{{!home.hotServiceList.length}}" class="empty-inline">服务项目正在准备中，欢迎联系门店咨询。</view>
  </view>
  <view class="home-assurance" wx:if="{{modules.services && home.advantageList.length}}"><text class="eyebrow">{{sectionConfig.advantageTitle}}</text><view class="assurance-item" wx:for="{{home.advantageList}}" wx:key="index"><text class="assurance-number">0{{index + 1}}</text><text>{{item.text}}</text></view></view>
  <view class="section" wx:if="{{modules.stores && home.storeList.length}}"><view class="section-head"><view class="section-title">就在你身边</view><text class="section-desc">服务网点</text></view><view class="home-line" wx:for="{{home.storeList}}" wx:key="id"><view class="home-service-name">{{item.name}}</view><view class="muted">{{item.address}}</view></view></view>
  <view class="section" wx:if="{{modules.workers && home.recommendWorkerList.length}}"><view class="section-head"><view class="section-title">认识服务你的人</view></view><view class="home-line" wx:for="{{home.recommendWorkerList}}" wx:key="workerId"><view class="home-service-name">{{item.workerName}}</view><view class="muted">{{item.intro}}</view></view></view>
  <view class="section" wx:if="{{modules.reviews && home.reviewList.length}}"><view class="section-title">服务后的真实反馈</view><view class="home-quote" wx:for="{{home.reviewList}}" wx:key="id"><text class="price-text">{{item.rating}} / 5</text><view>{{item.content}}</view></view></view>
  <view class="section home-contact" wx:if="{{modules.contact}}"><text class="eyebrow">我们在这里</text><view class="section-title">有问题，随时联系。</view><view wx:for="{{home.storeList}}" wx:key="id" class="contact-row"><text>{{item.name}}</text><button wx:if="{{item.phone}}" data-phone="{{item.phone}}" bindtap="callStore">{{item.phone}} ↗</button></view><view wx:if="{{home.website}}" class="muted">{{home.website}}</view></view>
  <view class="home-quick"><view bindtap="openOrderTab"><text>我的订单</text><text class="muted">查看预约进度 ›</text></view><view bindtap="openAddressTab"><text>服务地址</text><text class="muted">让上门更顺利 ›</text></view></view>
  <view class="bind-mask" wx:if="{{profile.nickname && bindPopupVisible}}"><view class="bind-popup"><view class="section-title">留下联系手机号</view><view class="muted bind-desc">便于预约确认与上门联系。</view><button class="primary-btn" open-type="getPhoneNumber" bindgetphonenumber="handleBindPhone">绑定微信手机号</button><button class="ghost-btn bind-close" bindtap="closeBindPopup">稍后再说</button></view></view>
</view>

