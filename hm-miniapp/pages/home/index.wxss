.home-page {
  background:
    radial-gradient(circle at top right, rgba(255, 183, 77, 0.22), transparent 28%),
    linear-gradient(180deg, #fff8f2 0%, #f5f7fb 48%, #f8fafc 100%);
}

.home-hero {
  padding: 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #fff4e9 0%, #ffffff 55%, #eef5ff 100%);
  box-shadow: 0 18rpx 44rpx rgba(224, 124, 48, 0.12);
  margin-bottom: 24rpx;
}

.home-search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.home-city {
  min-width: 104rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #24324a;
}

.home-search-box {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  box-shadow: inset 0 0 0 2rpx rgba(255, 184, 125, 0.26);
}

.home-search-placeholder {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #8a94a6;
}

.home-search-action {
  min-width: 120rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8c46 0%, #ff6c2f 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 30rpx rgba(255, 108, 47, 0.26);
}

.search-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}

.search-icon-circle {
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid #ff7a33;
  border-radius: 50%;
}

.search-icon-handle {
  position: absolute;
  right: 0;
  bottom: 2rpx;
  width: 12rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #ff7a33;
  transform: rotate(45deg);
  transform-origin: center;
}

.price-tabs {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.price-tab {
  flex: 1;
  min-height: 96rpx;
  padding: 18rpx 14rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fff3e8 100%);
}

.price-tab-title {
  font-size: 22rpx;
  color: #314158;
  line-height: 1.5;
}

.price-tab-price {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #ff7a33;
  font-weight: 700;
}

.section-soft {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(247, 250, 255, 0.98) 100%);
}

.service-nav-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 20rpx 12rpx;
}

.service-nav-item {
  text-align: center;
}

.service-nav-icon-wrap {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 12rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #ffffff 0%, #eef4ff 100%);
  box-shadow: 0 10rpx 20rpx rgba(71, 114, 193, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.service-nav-icon {
  width: 56rpx;
  height: 56rpx;
}

.service-nav-icon--empty {
  border-radius: 18rpx;
  background: linear-gradient(135deg, #dfe9ff 0%, #edf3ff 100%);
}

.service-nav-name {
  font-size: 22rpx;
  color: #334155;
  line-height: 1.5;
}

.promo-grid {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: 16rpx;
}

.promo-main,
.promo-small,
.quick-action {
  border-radius: 26rpx;
  background: #ffffff;
  padding: 24rpx;
}

.promo-main {
  min-height: 268rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #fff1df 0%, #ffffff 100%);
}

.promo-copy {
  flex: 1;
  min-width: 0;
}

.promo-main-image {
  width: 156rpx;
  height: 156rpx;
  border-radius: 24rpx;
  margin-left: 18rpx;
}

.promo-side {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.promo-small {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(180deg, #f6f9ff 0%, #ffffff 100%);
}

.promo-small-image {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  margin-left: 16rpx;
}

.promo-main-title,
.promo-small-title,
.quick-action-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #162033;
}

.promo-main-desc,
.promo-small-desc,
.quick-action-desc {
  font-size: 22rpx;
  color: #7b8798;
  margin-top: 10rpx;
}

.service-horizontal {
  white-space: nowrap;
}

.service-horizontal-list {
  display: inline-flex;
  gap: 16rpx;
}

.service-mini-card {
  width: 220rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 26rpx rgba(15, 23, 42, 0.06);
}

.service-mini-cover,
.service-grid-cover {
  width: 100%;
  height: 156rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #e9eef8 0%, #f7f9fc 100%);
}

.service-mini-cover--empty,
.service-grid-cover--empty,
.advantage-icon--empty {
  background: linear-gradient(135deg, #e9eef8 0%, #f7f9fc 100%);
}

.service-mini-title,
.service-grid-title {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #162033;
  line-height: 1.5;
}

.service-mini-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7b8798;
}

.service-list-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.service-grid-card {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 24rpx;
  padding: 18rpx;
  box-shadow: 0 12rpx 26rpx rgba(15, 23, 42, 0.06);
}

.service-grid-price {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #ff7a33;
  font-weight: 700;
}

.advantage-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.advantage-item {
  padding: 14rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #5e6b7d;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.advantage-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 10rpx;
}

.quick-entry-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.bind-mask {
  position: fixed;
  inset: 0;
  background: rgba(47, 36, 30, 0.34);
  display: flex;
  align-items: flex-end;
  z-index: 50;
}

.bind-popup {
  width: 100%;
  padding: 34rpx 28rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #fffaf5;
}

.bind-desc {
  margin: 14rpx 0 28rpx;
  line-height: 1.8;
}

.bind-close {
  margin-top: 16rpx;
}

.search-icon--light .search-icon-circle { border-color: #ffffff; }
.search-icon--light .search-icon-handle { background: #ffffff; }

