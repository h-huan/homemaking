.home-page{background:var(--hm-paper);padding:36rpx 32rpx 160rpx}.home-intro{padding:24rpx 0 36rpx}.home-title{font-size:64rpx;line-height:1.25;font-weight:650;letter-spacing:-2rpx;margin:20rpx 0}.home-title text{display:block;color:var(--hm-primary)}.home-subtitle{font-size:26rpx;color:var(--hm-muted)}.home-search{display:flex;align-items:center;gap:20rpx;background:#fff;border:1rpx solid var(--hm-line);padding:26rpx 24rpx;border-radius:12rpx;font-size:25rpx}.home-search-label{font-weight:700;color:var(--hm-primary)}.search-arrow{margin-left:auto;font-size:32rpx}.home-steps{display:flex;justify-content:space-between;padding:24rpx 0 40rpx;color:var(--hm-muted);font-size:21rpx;border-bottom:1rpx solid var(--hm-line);margin-bottom:40rpx}.home-page .section{margin-bottom:54rpx}.home-page .section-title{font-size:36rpx;line-height:1.4}.home-page .section-desc{color:var(--hm-muted)}.home-categories{display:grid;grid-template-columns:repeat(4,1fr);gap:26rpx 14rpx;margin-top:28rpx}.home-category{text-align:center;font-size:23rpx;color:var(--hm-text)}.home-category image,.category-letter{width:92rpx;height:92rpx;margin:0 auto 16rpx;background:var(--hm-primary-soft);border-radius:24rpx}.home-category image{padding:20rpx}.category-letter{display:flex;align-items:center;justify-content:center;padding:16rpx;font-size:20rpx;color:var(--hm-primary);overflow:hidden}.home-banners{height:280rpx;border-radius:16rpx;overflow:hidden}.home-banners image{width:100%;height:100%}.home-service{display:flex;gap:26rpx;padding:26rpx 0;border-bottom:1rpx solid var(--hm-line)}.home-service-cover{width:192rpx;height:204rpx;border-radius:12rpx;flex-shrink:0}.home-service-placeholder{display:flex;align-items:center;justify-content:center;background:var(--hm-primary-soft);color:var(--hm-primary);font-size:52rpx;font-weight:700;letter-spacing:4rpx}.home-service-copy{flex:1;min-width:0;padding:10rpx 0;display:flex;flex-direction:column}.home-service-name{font-size:30rpx;font-weight:700;line-height:1.5}.home-service-desc{font-size:24rpx;line-height:1.7;margin:10rpx 0}.home-service-bottom{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:auto}.home-service-bottom .price-text{font-size:34rpx;color:var(--hm-primary)}.price-unit{font-size:22rpx;font-weight:400;margin-left:5rpx}.home-service-action{font-size:22rpx;color:var(--hm-primary)}.home-assurance{padding:32rpx;background:var(--hm-primary);border-radius:14rpx;color:#fff;margin-bottom:50rpx}.home-assurance .eyebrow{color:#d1e2d9}.assurance-item{display:flex;gap:24rpx;padding:22rpx 0;border-bottom:1rpx solid #ffffff26;font-size:27rpx}.assurance-item:last-child{border:0}.assurance-number{color:#e5b678;font-size:22rpx}.home-line{padding:26rpx 0;border-bottom:1rpx solid var(--hm-line)}.home-line .muted{font-size:25rpx;line-height:1.8;margin-top:8rpx}.home-quote{padding:30rpx 0;border-bottom:1rpx solid var(--hm-line);font-size:28rpx;line-height:1.8}.home-contact{padding:30rpx;background:var(--hm-primary-soft);border-radius:14rpx}.contact-row{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin:26rpx 0;font-size:25rpx}.contact-row button{background:transparent;color:var(--hm-primary);padding:0;margin:0;font-size:25rpx}.home-quick{display:grid;grid-template-columns:1fr 1fr;gap:24rpx}.home-quick>view{padding:28rpx 0;border-top:2rpx solid var(--hm-primary);font-size:29rpx}.home-quick .muted{display:block;font-size:23rpx;margin-top:12rpx}.empty-inline{padding:36rpx 0;color:var(--hm-muted);line-height:1.8}.bind-mask{position:fixed;inset:0;background:#112c2470;display:flex;align-items:flex-end;z-index:99}.bind-popup{width:100%;background:var(--hm-paper);padding:48rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));border-radius:32rpx 32rpx 0 0}.bind-desc{margin:16rpx 0 30rpx}.bind-close{margin-top:16rpx}
