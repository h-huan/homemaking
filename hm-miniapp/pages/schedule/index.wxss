.schedule-page {
  background:
    radial-gradient(circle at top left, rgba(43, 109, 248, 0.08), transparent 260rpx),
    #f7f8fa;
}

.schedule-toolbar {
  margin-bottom: 20rpx;
}

.schedule-address-pill {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  gap: 10rpx;
  padding: 0 20rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.04);
}

.schedule-address-icon {
  color: #2b6df8;
  font-size: 26rpx;
}

.schedule-address-text {
  max-width: 560rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #374151;
}

.schedule-calendar-card {
  padding: 30rpx 24rpx 26rpx;
}

.calendar-head,
.week-row,
.legend-row,
.schedule-order-item,
.schedule-feature-top {
  display: flex;
  align-items: center;
}

.calendar-head {
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.calendar-switch {
  width: 132rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #f6f7fb;
  color: #6b7280;
  font-size: 24rpx;
}

.calendar-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.week-row {
  justify-content: space-between;
  margin-bottom: 18rpx;
  color: #9ca3af;
  font-size: 24rpx;
}

.week-row text,
.blank-day,
.day-cell {
  width: 13.5%;
}

.week-row text {
  text-align: center;
}

.days-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  min-height: 112rpx;
  margin-bottom: 12rpx;
  padding-top: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 22rpx;
}

.day-cell.active {
  background: #f7faff;
}

.day-cell.today .day-number {
  color: #2b6df8;
}

.day-number {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.today-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #2b6df8;
}

.day-mark {
  min-width: 72rpx;
  margin-top: 10rpx;
  padding: 0 10rpx;
  height: 34rpx;
  line-height: 34rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  text-align: center;
}

.day-mark.orange {
  background: #fff2e5;
  color: #d97706;
}

.day-mark.blue {
  background: #edf4ff;
  color: #2563eb;
}

.day-mark.green {
  background: #ecfdf3;
  color: #16a34a;
}

.day-mark.gray {
  background: #f3f4f6;
  color: #6b7280;
}

.legend-row {
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 16rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.legend-dot.orange {
  background: #f08a24;
}

.legend-dot.blue {
  background: #2b6df8;
}

.legend-dot.green {
  background: #31b36b;
}

.schedule-login-box {
  text-align: center;
  padding: 56rpx 24rpx;
}

.schedule-illus {
  width: 220rpx;
  height: 220rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background:
    radial-gradient(circle at 35% 35%, #ffffff 0%, #dbe8ff 42%, #eef4ff 100%);
}

.schedule-login-title {
  margin-bottom: 14rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.schedule-login-btn {
  margin-top: 28rpx;
}

.schedule-feature-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #447ef5 0%, #5c92ff 100%);
  color: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(68, 126, 245, 0.16);
}

.schedule-feature-top {
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.schedule-feature-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

.schedule-feature-time,
.schedule-feature-address {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.88);
}

.schedule-order-item {
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.schedule-order-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.schedule-order-main {
  flex: 1;
}

.schedule-order-title {
  margin-bottom: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}
