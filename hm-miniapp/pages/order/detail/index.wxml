<view class="page safe-bottom" style="{{themeStyle}}">
  <view class="hero-card">
    <view class="order-head">
      <view class="section-title">{{detail.statusMeta.label}}</view>
      <view class="status-tag {{detail.statusMeta.className}}">{{detail.statusMeta.label}}</view>
    </view>
    <view class="muted">{{detail.statusMeta.desc}}</view>
    <view class="detail-amount">￥{{detail.payAmount}}</view>
  </view>

  <view class="card">
    <view class="section-title">订单信息</view>
    <view class="fee-line"><text>订单编号</text><text>{{detail.orderNo}}</text></view>
    <view class="fee-line"><text>服务名称</text><text>{{detail.serviceName}}</text></view>
    <view class="fee-line"><text>预约时间</text><text>{{detail.appointmentDate}} {{detail.appointmentTimeSlot}}</text></view>
    <view class="fee-line"><text>联系人</text><text>{{detail.contactName}} {{detail.contactMobile}}</text></view>
    <view class="fee-line"><text>服务地址</text><text class="detail-address">{{detail.serviceAddress}}</text></view>
  </view>

  <view class="card">
    <view class="section-title">服务项</view>
    <view class="fee-line" wx:for="{{detail.itemList}}" wx:key="orderItemId">
      <text>{{item.itemName}} x {{item.quantity}}</text>
      <text>￥{{item.itemAmount}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{detail.operateLogs.length}}">
    <view class="section-title">处理进度</view>
    <view class="log-item" wx:for="{{detail.operateLogs}}" wx:key="logId">
      <view class="log-dot"></view>
      <view class="log-content">
        <view class="log-title">{{item.actionDesc}}</view>
        <view class="muted">{{item.createTime}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">预约提醒</view>
    <view class="fee-line"><text>接收上门提醒</text><switch checked="{{reminderEnabled}}" disabled="{{savingPreference}}" data-key="reminderEnabled" bindchange="handlePreference" /></view>
    <view class="fee-line"><text>允许必要时使用短信提醒</text><switch checked="{{allowSms}}" disabled="{{savingPreference}}" data-key="allowSms" bindchange="handlePreference" /></view>
    <button wx:if="{{subscriptionTemplates.length}}" bindtap="handleSubscribe">订阅微信服务通知</button>
  </view>
  <view class="card" wx:if="{{detail.fulfillmentStatus}}"><view class="section-title">履约状态</view><view class="fulfillment-line"><text>{{detail.fulfillmentLabel}}</text><text>服务过程凭证仅限本订单相关人员查看</text></view><button wx:for="{{evidence}}" wx:key="id" class="evidence-link" data-id="{{item.id}}" bindtap="previewEvidence">查看{{item.phase === 'BEFORE' ? '服务前' : '服务后'}}照片 · {{item.note || item.created_at}}</button></view>
  <view class="card" wx:if="{{detail.aftersales.length}}"><view class="section-title">售后进度</view><view class="fee-line" wx:for="{{detail.aftersales}}" wx:key="id"><text>{{item.reason}}</text><text>{{item.status}}</text></view></view>
  <view class="bottom-bar action-grid" wx:if="{{detail.orderStatus === '10' || detail.orderStatus === '30' || detail.orderStatus === '40' || (detail.orderStatus === '60' && !detail.review) || (detail.refundableAmount > 0 && detail.orderStatus === '60')}}">
    <button wx:if="{{detail.orderStatus === '10' || detail.orderStatus === '30' || detail.orderStatus === '40'}}" class="ghost-btn" bindtap="goReschedule">改期</button>
    <button wx:if="{{detail.orderStatus === '10'}}" class="ghost-btn" bindtap="handleCancel">取消预约</button>
    <button wx:if="{{detail.orderStatus === '10'}}" class="primary-btn" bindtap="handlePay" loading="{{paying}}" disabled="{{paying}}">微信支付</button>
    <button wx:if="{{detail.orderStatus === '60' && !detail.review}}" class="primary-btn" bindtap="goReview">评价服务</button>
    <button wx:if="{{detail.refundableAmount > 0 && (detail.orderStatus === '30' || detail.orderStatus === '40' || detail.orderStatus === '60')}}" class="secondary-btn" bindtap="goAftersale">申请售后</button>
  </view>
</view>
