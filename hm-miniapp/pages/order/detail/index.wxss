.detail-amount {
  margin-top: 22rpx;
  font-size: 46rpx;
  color: var(--hm-accent);
  font-weight: 700;
}

.detail-address {
  max-width: 420rpx;
  text-align: right;
  line-height: 1.6;
}

.log-item {
  display: flex;
  gap: 18rpx;
  padding: 12rpx 0;
}

.log-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--hm-accent);
  margin-top: 10rpx;
}

.log-title {
  font-weight: 600;
  margin-bottom: 8rpx;
}
.fulfillment-line{display:flex;justify-content:space-between;gap:24rpx;color:var(--hm-muted);font-size:24rpx}.action-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14rpx}.action-grid button:only-child{grid-column:1/-1}
