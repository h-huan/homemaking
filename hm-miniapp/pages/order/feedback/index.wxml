<view class="page safe-bottom" style="{{themeStyle}}"><view class="page-intro"><text class="eyebrow">{{mode==='review'?'REVIEW':'AFTERSALE'}}</text><view class="page-title">{{mode==='review'?'说说这次服务':'申请售后处理'}}</view><view class="muted">{{mode==='review'?'你的反馈会帮助我们持续改进。':'提交后可在订单详情查看审核和退款进度。'}}</view></view><view class="card" wx:if="{{mode==='review'}}"><view class="section-title">服务评分</view><view class="stars"><text wx:for="{{stars}}" wx:key="*this" class="{{rating>=item?'active':''}}" data-value="{{item}}" bindtap="rate">★</text></view></view><view class="card" wx:else><view class="section-title">申请退款金额</view><view class="input-card amount"><text>¥</text><input type="digit" value="{{amount}}" bindinput="amount" /></view><view class="muted">最多可申请 ¥{{maxAmount}}</view></view><view class="card"><view class="section-title">{{mode==='review'?'评价内容':'问题与诉求'}}</view><view class="input-card"><textarea class="textarea-field" maxlength="1000" value="{{content}}" bindinput="input" placeholder="请具体描述服务体验或需要处理的问题" /></view></view><view class="bottom-bar"><button class="primary-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{mode==='review'?'提交评价':'提交售后申请'}}</button></view></view>
