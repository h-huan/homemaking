.rating-block+.rating-block{margin-top:34rpx}.stars{display:flex;justify-content:space-between;gap:12rpx;margin-top:20rpx}.stars text{flex:1;text-align:center;font-size:58rpx;color:#d8dcd9}.stars .active{color:#e09343}.amount{display:flex;align-items:center;gap:12rpx}.amount input{height:88rpx;font-size:36rpx;font-weight:700;flex:1}.chip-row{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:22rpx}.chip{width:auto;min-width:180rpx;margin:0;padding:0 24rpx;border:1rpx solid #dde5df;background:#fff;color:#4c5b52}.chip.active{border-color:var(--brand);background:var(--brand-soft);color:var(--brand)}.section-title.sub{margin-top:32rpx}.review-images{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx;margin:24rpx 0}.review-image-wrap,.review-image-add{position:relative;width:100%;aspect-ratio:1;border-radius:18rpx;overflow:hidden}.review-image{width:100%;height:100%}.review-image-remove{position:absolute;top:8rpx;right:8rpx;width:48rpx;height:48rpx;min-width:0;padding:0;line-height:44rpx;border-radius:50%;background:rgba(0,0,0,.58);color:#fff}.review-image-add{display:flex;flex-direction:column;align-items:center;justify-content:center;margin:0;border:1rpx dashed var(--hm-line);background:var(--hm-paper);color:var(--hm-muted);font-size:42rpx}.review-image-add text{font-size:22rpx}
