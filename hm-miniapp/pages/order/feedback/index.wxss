.stars{display:flex;gap:20rpx;margin-top:24rpx}.stars text{font-size:58rpx;color:#d8dcd9}.stars .active{color:#e09343}.amount{display:flex;align-items:center;gap:12rpx}.amount input{height:88rpx;font-size:36rpx;font-weight:700;flex:1}.chip-row{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:22rpx}.chip{width:auto;min-width:180rpx;margin:0;padding:0 24rpx;border:1rpx solid #dde5df;background:#fff;color:#4c5b52}.chip.active{border-color:var(--brand);background:var(--brand-soft);color:var(--brand)}.section-title.sub{margin-top:32rpx}
