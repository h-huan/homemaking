<view class="page" style="{{themeStyle}}">
  <view class="hero-card result-card">
    <view class="result-icon">成</view>
    <view class="result-title">预约提交成功</view>
    <view class="result-desc">{{statusDesc}}</view>
    <view class="result-amount">预计金额 ￥{{payAmount}}</view>
  </view>

  <view class="card">
    <view class="fee-line"><text>订单编号</text><text>{{orderNo}}</text></view>
    <view class="fee-line"><text>当前状态</text><text>{{statusLabel}}</text></view>
  </view>

  <button class="primary-btn" bindtap="goOrderDetail">查看订单详情</button>
  <button class="ghost-btn result-btn" bindtap="goHome">返回首页</button>
</view>
