.category-page {
  padding: 0;
  background: linear-gradient(180deg, #fff8f2 0%, #f6f8fc 100%);
}

.category-layout {
  display: flex;
  height: 100vh;
}

.category-side {
  width: 182rpx;
  background: linear-gradient(180deg, #f2f4f8 0%, #eef2f7 100%);
}

.category-side-item {
  position: relative;
  min-height: 92rpx;
  padding: 24rpx 18rpx 24rpx 28rpx;
  color: #617084;
  font-size: 26rpx;
  display: flex;
  align-items: center;
}

.category-side-item.active {
  background: #ffffff;
  color: #1f2937;
  font-weight: 700;
}

.side-marker {
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: transparent;
}

.category-side-item.active .side-marker {
  background: linear-gradient(180deg, #ff8c46 0%, #ff6c2f 100%);
}

.category-main {
  flex: 1;
  padding: 24rpx;
}

.category-banner {
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff0df 0%, #ffffff 100%);
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.category-banner-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
}

.category-banner-desc {
  margin-top: 12rpx;
  color: #ff7a33;
  font-size: 24rpx;
}

.category-banner-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
}

.category-section {
  margin-bottom: 28rpx;
}

.center-title {
  text-align: center;
  margin-bottom: 18rpx;
}

.mini-nav-grid,
.category-service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.mini-nav-item,
.category-service-item {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 22rpx;
  padding: 18rpx 12rpx;
  text-align: center;
  box-shadow: 0 12rpx 26rpx rgba(15, 23, 42, 0.06);
}

.mini-nav-icon,
.category-service-cover {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 14rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #edf2fb 0%, #f9fbff 100%);
}

.mini-nav-icon--empty,
.category-service-cover--empty {
  background: linear-gradient(135deg, #edf2fb 0%, #f9fbff 100%);
}

.mini-nav-name,
.category-service-name {
  font-size: 24rpx;
  line-height: 1.5;
  color: #1f2937;
}

.category-service-price {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #ff7a33;
  font-weight: 700;
}
