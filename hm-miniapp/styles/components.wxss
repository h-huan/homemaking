page {
  background: var(--hm-canvas);
  color: var(--hm-text);
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 180rpx;
}

.page.compact {
  padding-bottom: 120rpx;
}

.safe-bottom {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.hero-card,
.card,
.soft-card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.04);
}

.card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.soft-card {
  padding: 24rpx;
}

.hero-card {
  padding: 32rpx 30rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
}

.section {
  margin-bottom: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--hm-text);
}

.section-desc {
  font-size: 24rpx;
  color: #9d8d82;
}

.muted {
  color: var(--hm-muted);
}

.price-text {
  color: var(--hm-accent);
  font-weight: 700;
}

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 110rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #fff1e3;
  color: #c96827;
  font-size: 22rpx;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  height: 44rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: #fff1e3;
  color: #d36c27;
}

.status-tag.gray {
  background: #f3efec;
  color: var(--hm-muted);
}

.status-tag.green {
  background: #e9f7ee;
  color: #2f9e62;
}

.status-tag.blue {
  background: #edf4ff;
  color: #3376d3;
}

.primary-btn,
.secondary-btn,
.ghost-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.primary-btn {
  background: linear-gradient(135deg, #236b5a 0%, var(--hm-primary) 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(230, 122, 46, 0.18);
}

.secondary-btn {
  background: #fff3e6;
  color: #c96827;
}

.ghost-btn {
  background: #ffffff;
  color: #7b6b61;
  border: 1rpx solid #eadfd4;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -10rpx 30rpx rgba(15, 23, 42, 0.05);
}

.input-card {
  background: #fffaf6;
  border: 1rpx solid #f1e3d8;
  border-radius: 22rpx;
  padding: 0 24rpx;
}

.input-field,
.textarea-field {
  width: 100%;
  color: var(--hm-text);
  font-size: 28rpx;
}

.input-field {
  height: 88rpx;
  line-height: 88rpx;
}

.textarea-field {
  min-height: 180rpx;
  padding: 24rpx 0;
}

.empty-wrap {
  padding: 120rpx 48rpx;
  text-align: center;
}

.empty-illus {
  width: 180rpx;
  height: 180rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #fff2e5 0%, #ffe1bf 100%);
}

.page-intro{padding:28rpx 8rpx 36rpx}.page-title{margin:10rpx 0 16rpx;font-size:48rpx;font-weight:750;color:var(--hm-text)}
.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:var(--hm-primary)}
